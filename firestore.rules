rules_version = '2';

// Each person can read and write only their own gallery:
//   users/{uid}/artists/...   and   users/{uid}/artworks/...
// (Sharing will be added later by allowing read access to galleries
//  the owner has chosen to share.)
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
